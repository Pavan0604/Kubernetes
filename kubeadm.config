apiVersion: kubeadm.k8s.io/v1beta3
kind: ClusterConfiguration
clusterName: kubernetes
controlPlaneEndpoint: "13.219.42.204:6443"
apiServer:
  certSANs:
    - "127.0.0.1"
    - "13.219.42.204" 
    - "localhost"
  extraArgs:
    bind-address: "0.0.0.0" 
controllerManager:
  extraArgs:
    bind-address: "0.0.0.0"
    cloud-provider: "external"
scheduler:
  extraArgs:
    bind-address: "0.0.0.0"
networking:
  podSubnet: "10.244.0.0/16" 
  serviceSubnet: "10.96.0.0/12"

---
apiVersion: kubeadm.k8s.io/v1beta3
kind: InitConfiguration
nodeRegistration:
  name: ip-172-31-86-224.us-east-1.compute.internal
  kubeletExtraArgs:
    cloud-provider: "external"
